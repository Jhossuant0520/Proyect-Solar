# Variables de entorno para despliegue / desarrollo.
# Copiar a .env (gitignored) o definirlas en el entorno del proceso/IDE.
# Spring Boot lee estas claves si se exportan como variables de entorno del SO.
#
# Producción:
#   SPRING_PROFILES_ACTIVE=prod
#   JWT_SECRET, DB_URL, DB_USERNAME y DB_PASSWORD son OBLIGATORIOS (sin defaults).

SPRING_PROFILES_ACTIVE=

DB_URL=jdbc:mysql://localhost:3306/solarfishdb
DB_USERNAME=root
DB_PASSWORD=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

JWT_SECRET=
