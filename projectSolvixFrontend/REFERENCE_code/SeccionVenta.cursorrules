t"],"headline-md":["Geist"],"label-md":["JetBrains Mono"],"headline-lg":["Geist"]},"fontSize":{"label-sm":["12px",{"lineHeight":"16px","letterSpacing":"0.08em","fontWeight":"500"}],"body-lg":["18px",{"lineHeight":"28px","fontWeight":"400"}],"body-md":["16px",{"lineHeight":"24px","fontWeight":"400"}],"display-lg":["64px",{"lineHeight":"72px","letterSpacing":"-0.04em","fontWeight":"700"}],"headline-lg-mobile":["32px",{"lineHeight":"40px","letterSpacing":"-0.02em","fontWeight":"600"}],"headline-md":["24px",{"lineHeight":"32px","letterSpacing":"-0.01em","fontWeight":"600"}],"label-md":["14px",{"lineHeight":"20px","letterSpacing":"0.05em","fontWeight":"500"}],"headline-lg":["40px",{"lineHeight":"48px","letterSpacing":"-0.02em","fontWeight":"600"}]}}}}</script></head><body class="bg-background font-body-md text-on-surface"><aside class="fixed left-0 top-0 h-full w-72 bg-surface-container-low z-50 flex flex-col shadow-[4px_0_24px_rgba(0,0,0,0.2)] border-r border-outline-variant/10"><div class="p-gutter mb-8 flex items-center gap-3"><div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center"><span class="material-symbols-outlined text-on-primary">token</span></div><span class="font-headline-md text-headline-md tracking-tighter text-primary">SOLVIX <span class="text-on-surface font-light">CORE</span></span></div><nav class="flex-1 px-4 space-y-1" data-active-classes="bg-primary-container/20 text-primary font-bold shadow-[inset_4px_0_0_0_#b2e7ff]"><a class="flex items-center px-6 py-3 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all group" data-path="dashboard" href="#"><span class="material-symbols-outlined mr-4 group-hover:scale-110 transition-transform">dashboard</span><span class="font-label-md text-label-md uppercase tracking-widest">Dashboard</span></a><a class="flex items-center px-6 py-3 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all group" data-path="productos" href="#"><span class="material-symbols-outlined mr-4 group-hover:scale-110 transition-transform">inventory_2</span><span class="font-label-md text-label-md uppercase tracking-widest">Productos</span></a><a aria-current="page" class="flex items-center px-6 py-3 rounded-lg transition-all group bg-primary-container/20 text-primary font-bold shadow-[inset_4px_0_0_0_#b2e7ff]" data-path="ventas" href="#"><span class="material-symbols-outlined mr-4 group-hover:scale-110 transition-transform">payments</span><span class="font-label-md text-label-md uppercase tracking-widest">Ventas</span></a><a class="flex items-center px-6 py-3 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all group" data-path="compras" href="#"><span class="material-symbols-outlined mr-4 group-hover:scale-110 transition-transform">shopping_cart</span><span class="font-label-md text-label-md uppercase tracking-widest">Compras</span></a><a class="flex items-center px-6 py-3 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all group" data-path="inventario" href="#"><span class="material-symbols-outlined mr-4 group-hover:scale-110 transition-transform">shelves</span><span class="font-label-md text-label-md uppercase tracking-widest">Inventario</span></a><a class="flex items-center px-6 py-3 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all group" data-path="reportes" href="#"><span class="material-symbols-outlined mr-4 group-hover:scale-110 transition-transform">query_stats</span><span class="font-label-md text-label-md uppercase tracking-widest">Reportes</span></a></nav><div class="px-8 py-6 border-t border-outline-variant/10"><div class="flex items-center gap-3"><div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center"><span class="material-symbols-outlined text-on-secondary-container">engineering</span></div><div><p class="text-label-md font-label-md text-on-surface">Terminal v2.4</p><p class="text-xs text-on-surface-variant">Status: Online</p></div></div></div></aside><div class="pl-72"><header class="fixed top-0 left-72 right-0 h-16 bg-background/80 backdrop-blur-xl z-40 px-gutter flex items-center justify-between border-b border-outline-variant/5"><div class="flex items-center gap-4 flex-1"><span class="text-on-surface-variant font-label-md text-label-md uppercase tracking-tighter">SOLVIX BI Terminal</span><div class="h-4 w-[1px] bg-outline-variant/30 mx-2"></div><div class="relative max-w-md w-full group"><span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px] group-focus-within:text-primary transition-colors">search</span><input class="w-full bg-surface-container-highest/30 border border-outline-variant/20 rounded-xl py-1.5 pl-10 pr-4 text-sm focus:outline-none focus:border-primary/50 focus:bg-surface-container-highest/50 transition-all text-on-surface" placeholder="Buscar transacciones, SKUs o reportes..." type="text"/></div></div><div class="flex items-center gap-6"><button class="flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors"><span class="material-symbols-outlined">notifications</span></button><div class="flex items-center gap-3 pl-4 border-l border-outline-variant/20"><div class="text-right hidden sm:block"><p class="text-label-md font-label-md text-on-surface leading-tight">Operador Alpha</p><p class="text-[10px] uppercase text-primary tracking-widest">Admin Ventas</p></div><div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center cursor-pointer hover:ring-2 ring-primary/30 transition-all"><span class="material-symbols-outlined text-on-primary text-[18px]">person</span></div></div></div></header><main class="relative pt-16 min-h-screen bg-background"><div class="flex flex-col w-full p-6 md:p-12 gap-8 bg-surface-container-lowest">
<!-- Header Section -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 border-b border-surface-container-highest pb-6 relative z-10">
<div>
<h1 class="font-display-lg text-display-lg text-on-surface mb-2 tracking-tight">Ventas</h1>
<p class="font-body-md text-body-md text-on-surface-variant max-w-xl">Consulta y controla las ventas de tu negocio. Analiza el rendimiento en tiempo real.</p>
</div>
<button class="flex items-center gap-2 bg-primary text-on-primary px-6 py-3 rounded-lg font-label-md text-label-md shadow-[0_0_12px_rgba(178,231,255,0.3)] hover:shadow-[0_0_24px_rgba(178,231,255,0.5)] transition-shadow duration-300 relative overflow-hidden group">
<span class="material-symbols-outlined text-on-primary">add</span>
            NUEVA VENTA
            <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></div>
</button>
</div>
<!-- KPIs Section (Bento Grid Style) -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 relative z-10">
<!-- KPI Card 1: Ventas Netas -->
<div class="bg-surface-container-low rounded-xl p-5 relative overflow-hidden shadow-lg border border-primary/20 backdrop-blur-md">
<div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-transparent"></div>
<div class="flex justify-between items-center mb-4 relative z-10">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Ventas Netas</span>
<span class="material-symbols-outlined text-primary text-lg">monitoring</span>
</div>
<div class="relative z-10">
<p class="font-headline-lg text-headline-lg text-on-surface">$124,500</p>
<div class="flex items-center gap-1 mt-2">
<span class="material-symbols-outlined text-secondary text-sm">arrow_upward</span>
<span class="font-label-sm text-label-sm text-secondary">+14.2% vs mes ant.</span>
</div>
</div>
<!-- Decorative Glow -->
<div class="absolute -right-4 -bottom-4 w-24 h-24 bg-primary/10 rounded-full blur-2xl"></div>
</div>
<!-- KPI Card 2: Pedidos -->
<div class="bg-surface-container-low rounded-xl p-5 relative overflow-hidden shadow-lg border border-outline-variant/30">
<div class="flex justify-between items-center mb-4 relative z-10">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Pedidos</span>
<span class="material-symbols-outlined text-tertiary text-lg">shopping_bag</span>
</div>
<div class="relative z-10">
<p class="font-headline-lg text-headline-lg text-on-surface">342</p>
<div class="flex items-center gap-1 mt-2">
<span class="material-symbols-outlined text-secondary text-sm">arrow_upward</span>
<span class="font-label-sm text-label-sm text-secondary">+5.8%</span>
</div>
</div>
</div>
<!-- KPI Card 3: Ticket Promedio -->
<div class="bg-surface-container-low rounded-xl p-5 relative overflow-hidden shadow-lg border border-outline-variant/30">
<div class="flex justify-between items-center mb-4 relative z-10">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Ticket Promedio</span>
<span class="material-symbols-outlined text-secondary text-lg">receipt_long</span>
</div>
<div class="relative z-10">
<p class="font-headline-lg text-headline-lg text-on-surface">$364</p>
<div class="flex items-center gap-1 mt-2">
<span class="material-symbols-outlined text-error text-sm">arrow_downward</span>
<span class="font-label-sm text-label-sm text-error">-2.1%</span>
</div>
</div>
</div>
<!-- KPI Card 4: Ganancia Bruta -->
<div class="bg-surface-container-low rounded-xl p-5 relative overflow-hidden shadow-lg border border-outline-variant/30">
<div class="flex justify-between items-center mb-4 relative z-10">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Ganancia Bruta</span>
<span class="material-symbols-outlined text-primary-fixed-dim text-lg">account_balance_wallet</span>
</div>
<div class="relative z-10">
<p class="font-headline-lg text-headline-lg text-on-surface">$48,200</p>
<div class="flex items-center gap-1 mt-2">
<span class="material-symbols-outlined text-secondary text-sm">arrow_upward</span>
