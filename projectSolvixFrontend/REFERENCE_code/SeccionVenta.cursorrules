<option>Este Mes</option>
<option>Mes Anterior</option>
<option>Este Año</option>
</select>
</div>
<div class="relative z-10 flex items-end justify-between">
<div>
<p class="font-headline-lg text-headline-lg text-on-surface">38.7%</p>
<p class="font-label-sm text-label-sm text-on-surface-variant mt-2">Objetivo: 40%</p>
</div>
