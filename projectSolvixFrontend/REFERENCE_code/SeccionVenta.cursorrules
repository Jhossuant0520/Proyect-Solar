<select class="bg-surface-container-low border border-outline-variant/30 rounded-lg py-2 pl-4 pr-10 font-label-md text-label-md text-on-surface focus:outline-none focus:border-primary/50 appearance-none cursor-pointer hover:bg-surface-container-high transition-colors">
