<script>
  // Simple Vanilla JS FAQ Accordion Toggle
  document.querySelectorAll('.faq-toggle').forEach(button => {
    button.addEventListener('click', () => {
      const content = button.nextElementSibling;
      const arrow = button.querySelector('.icon-arrow');
      const isHidden = content.classList.contains('hidden');
      
      // Close other accordions
      document.querySelectorAll('.faq-content').forEach(c => c.classList.add('hidden'));
      document.querySelectorAll('.icon-arrow').forEach(a => a.classList.remove('rotate-180'));

      if (isHidden) {
        content.classList.remove('hidden');
        arrow.classList.add('rotate-180');
      }
    });
  });
</script></main><footer class="w-full bg-surface-container-low shadow-[0_-1px_12px_rgba(0,123,185,0.06)] mt-space-xl"><div class="max-w-7xl mx-auto px-margin py-space-xl"><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter mb-space-xl"><div class="flex flex-col gap-space-md"><div class="flex items-center gap-space-sm"><img alt="LogoEmpresa1-pdf.png" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/AEtjO1Ulxj4iQqJUuHR923WQ1Pb59MnQCQo_REMMBfR-PNtQZ5P6K_G52Qi_GXl2vlQ7HvvIWpgnSzFKDHJBqI0b9cpG_IxQnFE1osAGMPlzNsGFYO8tgpPrOz5_OZT1wCzym6lGmS9-JZU7kibk7fyMowGVtlShAm6opJxFefiE4JHVEmadDEkI-hsnjgakG9gMD3haRbxYhXZxpeIKkw8czaV-sWsw1u2okuTwBkPQ9QxzAzkpsk4Xy4tWARz0W5yWbYB4NEpppS8KiQ"/><div class="flex flex-col"><span class="font-headline-sm text-headline-sm text-on-surface leading-tight">Computer &amp; Electronic</span><span class="font-code-spec text-code-spec text-primary font-medium tracking-wider uppercase">Tech &amp; Security</span></div></div><p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">Especialistas en servicio técnico de alta precisión, mantenimiento corporativo y venta de hardware informático y sistemas de seguridad electrónica de última generación.</p></div><div class="flex flex-col gap-space-sm"><h4 class="font-headline-sm text-headline-sm text-on-surface mb-space-xs">Navegación</h4><a class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors" data-path="inicio" href="#">Inicio</a><a class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors" data-path="servicios" href="#">Servicios Técnicos</a><a class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors" data-path="catalogo-de-equipos" href="#">Catálogo de Equipos</a><a class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors" data-path="sobre-nosotros" href="#">Sobre Nosotros</a><a class="font-body-s