up-hover:opacity-100 transition-opacity">warehouse</span><span class="font-label-md">Inventory</span></a><a class="flex items-center px-4 py-3 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all duration-200 group" data-path="reports" href="#"><span class="material-symbols-outlined mr-4 opacity-70 group-hover:opacity-100 transition-opacity">analytics</span><span class="font-label-md">Reports</span></a></nav><div class="p-6 border-t border-outline-variant/10"><div class="flex items-center gap-3 px-2 text-on-surface-variant"><span class="material-symbols-outlined text-[18px]">terminal</span><span class="font-label-sm uppercase tracking-widest">SYSTEM v4.0.1</span></div></div></aside><div class="pl-72"><header class="fixed top-0 left-72 right-0 h-20 bg-surface/80 backdrop-blur-xl z-40 border-b border-outline-variant/10 flex items-center justify-between px-margin-desktop"><div class="relative w-96 group"><span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">search</span><input class="w-full bg-surface-container border border-outline-variant/20 rounded-lg py-2 pl-11 pr-4 text-on-surface focus:outline-none focus:border-primary/50 transition-all" placeholder="Search Terminal (Cmd + K)" type="text"/></div><div class="flex items-center gap-6"><button class="relative text-on-surface-variant hover:text-primary transition-colors"><span class="material-symbols-outlined">notifications</span><span class="absolute top-0 right-0 w-2 h-2 bg-error rounded-full ring-2 ring-surface"></span></button><div class="flex items-center gap-4 pl-6 border-l border-outline-variant/20"><div class="text-right"><div class="font-label-md text-text-header">S. Chen</div><div class="font-label-sm text-primary uppercase">Lead Operator</div></div><div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center cursor-pointer hover:shadow-[0_0_12px_rgba(178,231,255,0.4)] transition-all"><span class="material-symbols-outlined text-on-primary text-[20px]">person</span></div></div></div></header><main class="relative pt-20 min-h-screen"><div class="flex flex-col w-full min-h-full">
<!-- Header Section -->
<div class="px-margin-desktop pt-8 pb-12">
<div class="flex items-end justify-between w-full">
<div class="flex flex-col relative z-10">
<span class="font-label-sm text-primary uppercase tracking-widest mb-3" style="writing-mode: horizontal-tb;">/ CRM MODULE</span>
<h1 class="font-display-lg text-text-header mb-2 relative">
                    Clientes
                    <span class="absolute -top-4 -right-8 w-12 h-12 bg-primary/10 rounded-full blur-xl pointer-events-none"></span>
</h1>
<p class="font-body-lg text-text-body max-w-xl text-balance">
                    Conoce a tus clientes y su comportamiento de compra
                </p>
</div>
<button class="relative group overflow-hidden bg-primary px-8 py-4 rounded-lg flex items-center gap-3 transition-all duration-300 hover:shadow-[0_0_24px_rgba(178,231,255,0.4)]">
<span class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></span>
<span class="material-symbols-outlined text-on-primary text-[20px]">person_add</span>
<span class="font-label-md text-on-primary">Nuevo cliente</span>
</button>
</div>
</div>
<!-- Summary KPIs - Grid -->
<div class="px-margin-desktop pb-12">
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
<!-- KPI 1 -->
<div class="relative bg-surface-container-low rounded-xl p-6 overflow-hidden shadow-lg transition-transform hover:-translate-y-1">
<div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-bl-full blur-2xl pointer-events-none"></div>
<div class="flex items-center justify-between mb-4">
<div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center">
<span class="material-symbols-outlined text-primary text-[20px]" style="font-variation-settings: 'FILL' 1;">groups</span>
</div>
<span class="font-label-sm text-secondary bg-secondary/10 px-2 py-1 rounded">+12% / mes</span>
</div>
<div class="flex flex-col">
<span class="font-display-lg text-text-header">2,451</span>
<span class="font-label-md text-text-body mt-1">Clientes Activos</span>
</div>
<div class="absolute bottom-0 left-0 w-full h-[2px] bg-gradient-to-r from-primary/50 to-transparent"></div>
</div>
<!-- KPI 2 -->
<div class="relative bg-surface-container-low rounded-xl p-6 overflow-hidden shadow-lg transition-transform hover:-translate-y-1">
<div class="absolute top-0 right-0 w-32 h-32 bg-secondary/5 rounded-bl-full blur-2xl pointer-events-none"></div>
<div class="flex items-center justify-between mb-4">
<div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center">
<span class="material-symbols-outlined text-secondary text-[20px]" style="font-variation-settings: 'FILL' 1;">person_add</span>
</div>
<span class="font-label-sm text-primary bg-primary/10 px-2 py-1 rounded">+34 esta sem.</span>
</div>
<div class="flex flex-col">
<span class="font-display-lg text-text-header">142</span>
<span class="font-label-md text-text-body mt-1">Nuevos Clientes (Mes)</span>
</div>
<div class="absolute bottom-0 left-0 w-full h-[2px] bg-gradient-to-r from-secondary/50 to-transparent"></div>
</div>
<!-- KPI 3 -->
<div class="relative bg-surface-container-low rounded-xl p-6 overflow-hidden shadow-lg transition-transform hover:-translate-y-1">
<div class="absolute top-0 right-0 w-32 h-32 bg-tertiary/5 rounded-bl-full blur-2xl pointer-events-none"></div>
<div class="flex items-center justify-between mb-4">
<div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center">
