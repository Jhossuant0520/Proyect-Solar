</div>
<span class="font-label-sm text-tertiary bg-tertiary/10 px-2 py-1 rounded">68% retención</span>
</div>
<div class="flex flex-col">
<span class="font-display-lg text-text-header">1,890</span>
<span class="font-label-md text-text-body mt-1">Clientes Recurrentes</span>
</div>
<div class="absolute bottom-0 left-0 w-full h-[2px] bg-gradient-to-r from-tertiary/50 to-transparent"></div>
</div>
<!-- KPI 4 -->
<div class="relative bg-surface-container-low rounded-xl p-6 overflow-hidden shadow-lg transition-transform hover:-translate-y-1">
<div class="absolute inset-0 bg-primary/5 opacity-50 blur-3xl z-0 pointer-events-none"></div>
<div class="absolute top-0 right-0 w-32 h-32 bg-primary/10 rounded-bl-full blur-2xl pointer-events-none z-0"></div>
