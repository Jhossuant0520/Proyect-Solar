<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/></head><body class="bg-background font-body-md text-on-surface antialiased"><aside class="fixed left-0 top-0 h-full w-72 bg-surface-container-low z-50 flex flex-col shadow-[0_1px_8px_rgba(0,0,0,0.15)] transition-all"><div class="p-8 flex items-center gap-3"><div class="w-10 h-10 bg-primary-container rounded-xl flex items-center justify-center shadow-[0_0_20px_rgba(79,209,255,0.2)]"><span class="material-symbols-outlined text-on-primary-container text-[24px]">bolt</span></div><span class="font-headline-md text-text-header tracking-tight">SOLVIX</span></div><nav class="flex-1 px-4 space-y-1 overflow-y-auto" data-active-classes="bg-secondary-container/20 text-secondary border-l-2 border-secondary"><a class="flex items-center px-4 py-3 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high rounded-lg transition-all group" data-path="dashboard" href="#"><span class="material-symbols-outlined mr-4 text-[22px]">dashboard</span><span class="font-label-md">DASHBOARD</span></a><a class="flex items-center px-4 py-3 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high rounded-lg transition-all group" data-path="products" href="#"><span class="material-symbols-outlined mr-4 text-[22px]">inventory_2</span><span class="font-label-md">PRODUCTS</span></a><a class="flex items-center px-4 py-3 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high rounded-lg transition-all group" data-path="sales" href="#"><span class="material-symbols-outlined mr-4 text-[22px]">point_of_sale</span><span class="font-label-md">SALES</span></a><a aria-current="page" class="flex items-center px-4 py-3 font-bold rounded-lg transition-all group bg-secondary-container/20 text-secondary border-l-2 border-secondary" data-path="purchases" href="#"><span class="material-symbols-outlined mr-4 text-[22px]">