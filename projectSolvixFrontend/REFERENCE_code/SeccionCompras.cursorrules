<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/></head><body class="bg-background font-body-md text-on-surface antialiased"><aside class="fixed left-0 top-0 h-full w-72 bg-surface-container-low z-50 flex flex-col shadow-[0_1px_8px_rgba(0,0,0,0.15)] transition-all"><div class="p-8 flex items-center gap-3"><div class="w-10 h-10 bg-primary-container rounded-xl flex items-center justify-center shadow-[0_0_20px_rgba(79,209,255,0.2)]"><span class="material-symbols-outlined text-on-primary-container text-[24px]">bolt</span></div><span class="font-headline-md text-text-header tracking-tight">SOLVIX</span></div><nav class="flex-1 px-4 space-y-1 overflow-y-auto" data-active-classes="bg-secondary-container/20 text-secondary border-l-2 border-secondary"><a class="flex items-center px-4 py-3 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high rounded-lg transition-all group" data-path="dashboard" href="#"><span class="material-symbols-outlined mr-4 text-[22px]">dashboard</span><span class="font-label-md">DASHBOARD</span></a><a class="flex items-center px-4 py-3 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high rounded-lg transition-all group" data-path="products" href="#"><span class="material-symbols-outlined mr-4 text-[22px]">inventory_2</span><span class="font-label-md">PRODUCTS</span></a><a class="flex items-center px-4 py-3 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high rounded-lg transition-all group" data-path="sales" href="#"><span class="material-symbols-outlined mr-4 text-[22px]">point_of_sale</span><span class="font-label-md">SALES</span></a><a aria-current="page" class="flex items-center px-4 py-3 font-bold rounded-lg transition-all group bg-secondary-container/20 text-secondary border-l-2 border-secondary" data-path="purchases" href="#"><span class="material-symbols-outlined mr-4 text-[22px]">shopping_cart</span><span class="font-label-md">PURCHASES</span></a><a class="flex items-center px-4 py-3 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high rounded-lg transition-all group" data-path="customers" href="#"><span class="material-symbols-outlined mr-4 text-[22px]">group</span><span class="font-label-md">CUSTOMERS</span></a><a class="flex items-center px-4 py-3 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high rounded-lg transition-all group" data-path="suppliers" href="#"><span class="material-symbols-outlined mr-4 text-[22px]">factory</span><span class="font-label-md">SUPPLIERS</span></a><a class="flex items-center px-4 py-3 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high rounded-lg transition-all group" data-path="inventory" href="#"><span class="material-symbols-outlined mr-4 text-[22px]">warehouse</span><span class="font-label-md">INVENTORY</span></a><a class="flex items-center px-4 py-3 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high rounded-lg transition-all group" data-path="reports" href="#"><span class="material-symbols-outlined mr-4 text-[22px]">monitoring</span><span class="font-label-md">REPORTS</span></a></nav><div class="p-4 mt-auto border-t border-outline-variant/10"><div class="bg-surface-container flex items-center gap-3 p-3 rounded-xl"><div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center"><span class="material-symbols-outlined text-on-primary text-[18px]">person</span></div><div class="overflow-hidden"><p class="text-label-md text-on-surface truncate">ENG_CHIEF</p><p class="text-label-sm text-on-surface-variant uppercase">System Admin</p></div></div></div></aside><div class="pl-72 flex flex-col min-h-screen"><header class="fixed top-0 left-72 right-0 h-16 bg-surface/80 backdrop-blur-xl z-40 border-b border-outline-variant/10 flex items-center justify-between px-8"><div class="relative w-96 group"><span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant group-focus-within:text-primary transition-colors">search</span><input class="w-full bg-surface-container-low border border-outline-variant/20 rounded-lg py-2 pl-10 pr-4 text-label-md focus:outline-none focus:border-primary/50 transition-all" placeholder="SYSTEM SEARCH_" type="text"/></div><div class="flex items-center gap-6"><button class="relative p-2 text-on-surface-variant hover:text-primary transition-colors"><span class="material-symbols-outlined">notifications</span><span class="absolute top-2 right-2 w-2 h-2 bg-error rounded-full"></span></button><button class="p-2 text-on-surface-variant hover:text-primary transition-colors"><span class="material-symbols-outlined">settings</span></button><div class="h-8 w-[1px] bg-outline-variant/20 mx-2"></div><div class="flex flex-col items-end"><span class="text-label-sm text-primary">UPTIME_99.98%</span><span class="text-label-sm text-on-surface-variant">v4.2.0-STABLE</span></div></div></header><main class="flex-1 pt-16 bg-background p-spacing-gutter"><div class="flex flex-col w-full gap-gutter">
<!-- Header Section -->
<div class="flex items-end justify-between w-full relative pt-12 pb-8">
<div class="absolute top-0 right-0 w-[600px] h-[300px] bg-primary/5 blur-[120px] rounded-full pointer-events-none"></div>
<div class="relative z-10">
<div class="flex items-center gap-3 mb-2">
<span class="font-label-sm text-primary uppercase tracking-widest">[PROCUREMENT_SYSTEM]</span>
