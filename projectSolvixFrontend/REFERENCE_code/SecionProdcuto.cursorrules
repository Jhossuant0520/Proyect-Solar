<!DOCTYPE html>

<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>SOLVIX - Productos</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "inverse-primary": "#006782",
                        "on-secondary-container": "#00374d",
                        "tertiary-fixed": "#9cf0ff",
                        "surface-container-low": "#151b2d",
                        "surface-variant": "#2e3447",
                        "inverse-on-surface": "#2a3043",
                        "on-surface-variant": "#bcc8cf",
                        "secondary-fixed-dim": "#7bd0ff",
                        "on-tertiary-fixed-variant": "#004f58",
                        "on-primary-fixed": "#001f29",
                        "tertiary-container": "#00d6ee",
                        "on-secondary-fixed-variant": "#004c69",
                        "surface-bright": "#33394c",
                        "surface-container-high": "#23293c",
                        "outline-variant": "#3d484e",
                        "on-error": "#690005",
                        "on-tertiary-container": "#005964",
                        "on-tertiary": "#00363d",
                        "on-tertiary-fixed": "#001f24",
                        "primary-fixed": "#bbe9ff",
                        "error": "#ffb4ab",
                        "on-background": "#dce1fb",
                        "on-secondary": "#00354a",
                        "background": "#0c1324",
                        "tertiary": "#8aedff",
                        "primary": "#b2e7ff",
                        "on-secondary-fixed": "#001e2c",
                        "surface-container-lowest": "#070d1f",
                        "inverse-surface": "#dce1fb",
                        "secondary-fixed": "#c4e7ff",
                        "primary-container": "#4fd1ff",
                        "on-primary-fixed-variant": "#004d63",
                        "text-header": "#FFFFFF",
                        "surface-tint": "#60d4ff",
                        "on-primary": "#003545",
                        "on-error-container": "#ffdad6",
                        "text-body": "#94a3b8",
                        "on-surface": "#dce1fb",
                        "surface-dim": "#0c1324",
                        "outline": "#879299",
                        "error-container": "#93000a",
                        "on-primary-container": "#00576f",
                        "tertiary-fixed-dim": "#00daf3",
                        "surface-container": "#191f31",
                        "secondary": "#7bd0ff",
                        "secondary-container": "#00a6e0",
                        "primary-fixed-dim": "#60d4ff",
                        "surface-container-highest": "#2e3447",
                        "surface": "#0f172a"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "margin-mobile": "20px",
                        "unit": "4px",
                        "gutter": "24px",
                        "margin-desktop": "64px",
                        "container-max": "1280px"
                    },
                    "fontFamily": {
                        "headline-lg-mobile": ["Geist"],
                        "display-lg": ["Geist"],
                        "body-lg": ["Geist"],
                        "label-md": ["JetBrains Mono"],
                        "label-sm": ["JetBrains Mono"],
                        "headline-lg": ["Geist"],
                        "body-md": ["Geist"],
                        "headline-md": ["Geist"]
                    },
                    "fontSize": {
                        "headline-lg-mobile": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "600" }],
                        "display-lg": ["64px", { "lineHeight": "72px", "letterSpacing": "-0.04em", "fontWeight": "700" }],
                        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
                        "label-md": ["14px", { "lineHeight": "20px", "letterSpacing": "0.05em", "fontWeight": "500" }],
                        "label-sm": ["12px", { "lineHeight": "16px", "letterSpacing": "0.08em", "fontWeight": "500" }],
                        "headline-lg": ["40px", { "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "600" }],
                        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "headline-md": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600" }]
                    }
                }
            }
        }
    </script>
<style>
        body { background-color: #020617; } /* Z-0 Floor */
        .glass-panel {
            background-color: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(79, 209, 255, 0.2);
        }
        .cyber-glow {
            box-shadow: 0 0 12px rgba(79, 209, 255, 0.3);
        }
        .cyber-glow:hover {
            box-shadow: 0 0 20px rgba(79, 209, 255, 0.5);
        }
        .input-glow:focus {
            border-color: #7bd0ff;
            box-shadow: 0 0 8px rgba(123, 208, 255, 0.4);
            outline: none;
        }
        .scanning-line {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(79, 209, 255, 0.8), transparent);
        }
    </style>
</head>
<body class="bg-background text-on-background font-body-md min-h-screen overflow-x-hidden">
<!-- TopAppBar -->
<header class="bg-surface/80 dark:bg-surface/80 backdrop-blur-xl text-primary dark:text-primary font-label-md text-label-md fixed top-0 right-0 w-[calc(100%-16rem)] h-16 border-b border-outline-variant/10 flex justify-between items-center px-gutter z-40 hidden md:flex transition-opacity duration-150 hover:opacity-80">
<div class="flex items-center gap-4 ml-64 flex-1">
<div class="relative w-96">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span>
<input class="w-full bg-surface-container-low border border-outline-variant/30 rounded-DEFAULT py-1.5 pl-10 pr-4 text-on-surface font-label-sm placeholder-on-surface-variant/50 input-glow" placeholder="Search product ID or name..." type="text"/>
</div>
</div>
<div class="flex items-center gap-6">
<button class="text-on-surface-variant hover:text-primary transition-colors flex items-center justify-center">
<span class="material-symbols-outlined" data-weight="fill" style="font-variation-settings: 'FILL' 0;">calendar_today</span>
</button>
<button class="text-on-surface-variant hover:text-primary transition-colors flex items-center justify-center relative">
<span class="material-symbols-outlined" data-weight="fill" style="font-variation-settings: 'FILL' 0;">notifications</span>
<span class="absolute top-0 right-0 w-2 h-2 bg-primary rounded-full cyber-glow"></span>
</button>
<button class="text-on-surface-variant hover:text-primary transition-colors flex items-center justify-center">
<span class="material-symbols-outlined" data-weight="fill" style="font-variation-settings: 'FILL' 0;">settings</span>
</button>
<div class="w-8 h-8 rounded-full border border-primary/30 overflow-hidden ml-2 flex-shrink-0">
<img alt="Administrator" class="w-full h-full object-cover" data-alt="A futuristic UI profile avatar portrait of a cyber-engineer administrator in a dimly lit, high-tech control room setting. Minimalist digital art style, glowing blue accents, hyper-detailed, professional and clean aesthetic." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBSspMH_gcmk5C0_wWIDoe4ec8xAINYXCqxtVljh-jTC6EOU5jW8b-sAPgrx9lVY-lXeYqv5yKxG6fYI9GKONMKPNHy6peUcFY5Fc3vkGk0EexuZpMyQiBUdGIw5Mue2EBTMWU_Cg65mhIE1e7yuPbbUudbgwXx2R1hkOxtmSXsi7VnYfinoh5AVt7d_0cC5JlDer6crjgX9UDRJGm5byOsg1obD9U_ar1X05H_CUgwRWMS9I0K0vvq"/>
</div>
</div>
</header>
<!-- SideNavBar -->
<nav class="bg-surface dark:bg-surface text-primary dark:text-primary font-body-md text-body-md w-64 h-screen fixed left-0 top-0 border-r border-outline-variant/10 bg-surface-container-low dark:bg-surface-container-low shadow-xl flex flex-col py-6 z-50">
<div class="px-6 mb-8">
<div class="font-headline-md text-headline-md font-bold text-primary dark:text-primary tracking-tighter">SOLVIX</div>
<div class="font-label-sm text-label-sm text-on-surface-variant mt-1">BI Terminal</div>
</div>
<div class="flex flex-col gap-1 px-2 flex-1">
<a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:text-primary transition-colors hover:bg-surface-variant/30 rounded-DEFAULT transition-all duration-200 ease-in-out active:scale-95" href="#">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">dashboard</span>
<span>Dashboard</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 bg-secondary-container/20 text-primary font-bold border-r-4 border-primary hover:bg-surface-variant/30 transition-all duration-200 ease-in-out active:scale-95" href="#">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">inventory_2</span>
<span>Products</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:text-primary transition-colors hover:bg-surface-variant/30 rounded-DEFAULT transition-all duration-200 ease-in-out active:scale-95" href="#">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">payments</span>
<span>Sales</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:text-primary transition-colors hover:bg-surface-variant/30 rounded-DEFAULT transition-all duration-200 ease-in-out active:scale-95" href="#">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">shopping_cart</span>
<span>Purchases</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:text-primary transition-colors hover:bg-surface-variant/30 rounded-DEFAULT transition-all duration-200 ease-in-out active:scale-95" href="#">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">group</span>
<span>Customers</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:text-primary transition-colors hover:bg-surface-variant/30 rounded-DEFAULT transition-all duration-200 ease-in-out active:scale-95" href="#">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">local_shipping</span>
<span>Suppliers</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:text-primary transition-colors hover:bg-surface-variant/30 rounded-DEFAULT transition-all duration-200 ease-in-out active:scale-95" href="#">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">warehouse</span>
<span>Inventory</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:text-primary transition-colors hover:bg-surface-variant/30 rounded-DEFAULT transition-all duration-200 ease-in-out active:scale-95" href="#">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">analytics</span>
<span>Reports</span>
</a>
</div>
</nav>
<!-- Main Canvas -->
<main class="ml-64 pt-24 px-margin-desktop pb-margin-desktop min-h-screen relative">
<!-- Environmental Glow -->
<div class="fixed top-1/4 left-1/3 w-96 h-96 bg-primary/5 rounded-full blur-[100px] pointer-events-none"></div>
<!-- Page Header -->
<div class="flex justify-between items-end mb-8 relative z-10">
<div>
<h1 class="font-headline-lg text-headline-lg text-text-header">Productos</h1>
<div class="font-body-md text-body-md text-on-surface-variant mt-2">
                    Administra tu catálogo y controla el estado de tus productos
                </div>
</div>
<button class="bg-primary text-on-primary font-label-md px-6 py-3 rounded-DEFAULT cyber-glow flex items-center gap-2 font-bold transition-all hover:bg-primary-fixed">
<span class="material-symbols-outlined text-[18px]">add</span>
                Nuevo producto
            </button>
</div>
<!-- Summary Indicators -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8 z-10 relative">
<div class="glass-panel p-4 rounded-lg">
<div class="flex items-center gap-3 mb-2">
<div class="w-8 h-8 rounded bg-primary/10 flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-[18px]">check_circle</span>
</div>
<span class="font-label-sm text-on-surface-variant uppercase">Productos activos</span>
</div>
<div class="font-headline-md text-text-header">1,248</div>
</div>
<div class="glass-panel p-4 rounded-lg">
<div class="flex items-center gap-3 mb-2">
<div class="w-8 h-8 rounded bg-error/10 flex items-center justify-center text-error">
<span class="material-symbols-outlined text-[18px]">warning</span>
</div>
<span class="font-label-sm text-on-surface-variant uppercase">Productos con stock crítico</span>
</div>
<div class="font-headline-md text-error">24</div>
</div>
<div class="glass-panel p-4 rounded-lg">
<div class="flex items-center gap-3 mb-2">
<div class="w-8 h-8 rounded bg-surface-container-highest flex items-center justify-center text-on-surface-variant">
<span class="material-symbols-outlined text-[18px]">hourglass_empty</span>
</div>
<span class="font-label-sm text-on-surface-variant uppercase">Productos sin movimiento</span>
</div>
<div class="font-headline-md text-text-header">86</div>
</div>
<div class="glass-panel p-4 rounded-lg">
<div class="flex items-center gap-3 mb-2">
<div class="w-8 h-8 rounded bg-tertiary/10 flex items-center justify-center text-tertiary">
<span class="material-symbols-outlined text-[18px]">monetization_on</span>
</div>
<span class="font-label-sm text-on-surface-variant uppercase">Valor actual del inventario</span>
</div>
<div class="font-headline-md text-tertiary">$1.4M</div>
</div>
</div>
<!-- Filter Bar -->
<div class="glass-panel p-4 mb-6 rounded-lg flex flex-wrap gap-4 items-center z-10 relative">
<div class="flex-1 min-w-[200px]">
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span>
<input class="w-full bg-surface-container-low border border-outline-variant/30 rounded-DEFAULT py-2 pl-10 pr-4 text-on-surface font-label-sm placeholder-on-surface-variant/50 input-glow" placeholder="Buscar por nombre o ID..." type="text"/>
</div>
</div>
<div class="w-36">
<select class="w-full bg-surface-container-low border border-outline-variant/30 rounded-DEFAULT py-2 px-3 text-on-surface font-label-sm input-glow appearance-none">
<option value="">Marca: Todas</option>
<option value="vx">VX</option>
<option value="solaredge">SolarEdge</option>
<option value="tesla">Tesla</option>
</select>
</div>
<div class="w-40">
<select class="w-full bg-surface-container-low border border-outline-variant/30 rounded-DEFAULT py-2 px-3 text-on-surface font-label-sm input-glow appearance-none">
<option value="">Categoría: Todas</option>
<option value="paneles">Paneles</option>
<option value="inversores">Inversores</option>
<option value="baterias">Baterías</option>
</select>
</div>
<div class="w-36">
<select class="w-full bg-surface-container-low border border-outline-variant/30 rounded-DEFAULT py-2 px-3 text-on-surface font-label-sm input-glow appearance-none">
<option value="">Estado: Todos</option>
<option value="activo">Activo</option>
<option value="inactivo">Inactivo</option>
<option value="borrador">Borrador</option>
</select>
</div>
<div class="w-36">
<select class="w-full bg-surface-container-low border border-outline-variant/30 rounded-DEFAULT py-2 px-3 text-on-surface font-label-sm input-glow appearance-none">
<option value="">Stock: Todos</option>
<option value="disponible">Disponible</option>
<option value="bajo">Bajo</option>
<option value="agotado">Agotado</option>
</select>
</div>
<button class="text-primary font-label-sm hover:text-primary-fixed transition-colors underline decoration-primary/50 underline-offset-4">
            Limpiar filtros
        </button>
</div>
<!-- Product Table Container -->
<div class="glass-panel rounded-lg overflow-hidden z-10 relative">
<div class="scanning-line w-full absolute top-0 left-0"></div>
<div class="overflow-x-auto">
<table class="w-full text-left border-collapse">
<thead>
<tr class="border-b border-outline-variant/20 bg-surface-container-low/50">
<th class="py-4 px-4 font-label-sm text-label-sm text-on-surface-variant uppercase w-12">Img</th>
<th class="py-4 px-4 font-label-sm text-label-sm text-on-surface-variant uppercase">Producto</th>
<th class="py-4 px-4 font-label-sm text-label-sm text-on-surface-variant uppercase">Marca</th>
<th class="py-4 px-4 font-label-sm text-label-sm text-on-surface-variant uppercase">Categoría</th>
<th class="py-4 px-4 font-label-sm text-label-sm text-on-surface-variant uppercase text-right">Precio de venta</th>
<th class="py-4 px-4 font-label-sm text-label-sm text-on-surface-variant uppercase text-right">Costo actual</th>
<th class="py-4 px-4 font-label-sm text-label-sm text-on-surface-variant uppercase">Stock</th>
<th class="py-4 px-4 font-label-sm text-label-sm text-on-surface-variant uppercase">Estado</th>
<th class="py-4 px-4 font-label-sm text-label-sm text-on-surface-variant uppercase text-right">Acciones</th>
</tr>
</thead>
<tbody class="font-body-md text-body-md text-on-surface divide-y divide-outline-variant/10">
<!-- Row 1 -->
<tr class="hover:bg-surface-variant/20 transition-colors group">
<td class="py-3 px-4">
<div class="w-10 h-10 bg-surface-container border border-outline-variant/30 rounded p-1">
<img alt="Panel" class="w-full h-full object-contain opacity-80" data-alt="Technical blueprint style rendering of a high-efficiency monocrystalline solar panel, dark background, cyan wireframe lines, high tech industrial aesthetic." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDUzUgDTHiBwBuggJJaR7wpjiNOb7E9i-sf6vsufsT5-onidG8cyljhfmyighZboepUvm3zwIyrZwBR6liDfSQoImUjI8QFrmOtoofqw013P-LjBbiF0uJB-CEL2CBrdNlk3-GlxM4LDmkWUp2-Iq_hwEXOB8Y3nhGiVYzfnexGqQ9BdIhl2nvMHHcUS5yD8wCuZpunTx9_TMSo8SljR-H1UhBilHIece9YSfM06AuPO8xQLoDby64_"/>
</div>
</td>
<td class="py-3 px-4">
<div class="font-semibold text-text-header">VX-700 BIFACIAL PRO</div>
<div class="font-label-sm text-on-surface-variant mt-0.5">#PNL-450</div>
</td>
<td class="py-3 px-4 font-label-sm text-on-surface">VX Solar</td>
<td class="py-3 px-4">
<span class="inline-block px-2 py-0.5 bg-surface-container border border-outline-variant/50 rounded font-label-sm text-[10px] text-on-surface-variant tracking-wider">PANELES</span>
</td>
<td class="py-3 px-4 text-right font-label-md text-primary">$ 185.00</td>
<td class="py-3 px-4 text-right font-label-md text-on-surface-variant group-hover:text-on-surface transition-colors">
<div class="flex items-center justify-end gap-2">
<span>$ 142.50</span>
<button class="opacity-0 group-hover:opacity-100 transition-opacity text-on-surface-variant hover:text-primary" title="Ajustar costo">
<span class="material-symbols-outlined text-[14px]">edit</span>
</button>
</div>
</td>
<td class="py-3 px-4">
<div class="flex items-center gap-2">
<span class="w-2 h-2 rounded-full bg-emerald-400 cyber-glow"></span>
<span class="font-label-sm text-emerald-400">324 Disponibles</span>
</div>
</td>
<td class="py-3 px-4">
<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border border-primary/30 bg-primary/10 font-label-sm text-[11px] text-primary">
                            Activo
                        </span>
</td>
<td class="py-3 px-4 text-right">
<div class="flex justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
<button class="w-8 h-8 rounded hover:bg-surface-variant flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors" title="Ver">
<span class="material-symbols-outlined text-[18px]">visibility</span>
</button>
<button class="w-8 h-8 rounded hover:bg-surface-variant flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors" title="Editar">
<span class="material-symbols-outlined text-[18px]">edit_note</span>
</button>
<button class="w-8 h-8 rounded hover:bg-surface-variant flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors" title="Más">
<span class="material-symbols-outlined text-[18px]">more_vert</span>
</button>
</div>
</td>
</tr>
<!-- Row 2 -->
<tr class="hover:bg-surface-variant/20 transition-colors group">
<td class="py-3 px-4">
<div class="w-10 h-10 bg-surface-container border border-outline-variant/30 rounded p-1">
<img alt="Inversor" class="w-full h-full object-contain opacity-80" data-alt="Technical blueprint style rendering of a hybrid solar inverter unit, dark background, cyan wireframe lines, high tech industrial aesthetic." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBzzHppc7UlU9hq68UW4nFzpQonhoNEI-RiuB0KJB-sr07wGDYu66I2o0Hg6Pk3XcqolswSGEgDh1ZwS8KNEc7tN5nRprTV8OHpB_JoSzeoZAbv1m9FjioJCuRtHDBS2jnAHapaOdsykqM8Wp9DkX8LKnnVpsgaRKRGVFCP3ntCHtqjtZvgltN1OpWu-bK2Uiqd_N8ANh5Z2zQREGS5f3n4O7IYTQUVqcbGqaTJ_EYrw19HchqQSna0"/>
</div>
</td>
<td class="py-3 px-4">
<div class="font-semibold text-text-header">Inversor Híbrido 5kW</div>
<div class="font-label-sm text-on-surface-variant mt-0.5">#INV-5K</div>
</td>
<td class="py-3 px-4 font-label-sm text-on-surface">SolarEdge</td>
<td class="py-3 px-4">
<span class="inline-block px-2 py-0.5 bg-surface-container border border-outline-variant/50 rounded font-label-sm text-[10px] text-on-surface-variant tracking-wider">INVERSORES</span>
</td>
<td class="py-3 px-4 text-right font-label-md text-primary">$ 850.00</td>
<td class="py-3 px-4 text-right font-label-md text-on-surface-variant group-hover:text-on-surface transition-colors">
<div class="flex items-center justify-end gap-2">
<span>$ 680.00</span>
<button class="opacity-0 group-hover:opacity-100 transition-opacity text-on-surface-variant hover:text-primary" title="Ajustar costo">
<span class="material-symbols-outlined text-[14px]">edit</span>
</button>
</div>
</td>
<td class="py-3 px-4">
<div class="flex items-center gap-2">
<span class="w-2 h-2 rounded-full bg-amber-400 cyber-glow"></span>
<span class="font-label-sm text-amber-400">12 Stock bajo</span>
</div>
</td>
<td class="py-3 px-4">
<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border border-primary/30 bg-primary/10 font-label-sm text-[11px] text-primary">
