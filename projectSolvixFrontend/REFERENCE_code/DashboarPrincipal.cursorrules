<!DOCTYPE html>

<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>SOLVIX - Product Details</title>
<!-- Font Setup -->
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&amp;family=Geist+Mono:wght@400;500&amp;display=swap" rel="stylesheet"/>
<!-- Tailwind CSS -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script data-purpose="tailwind-config">
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            app: {
              bg: '#09090b',       // Deepest dark
              panel: '#121215',    // Slightly lighter dark for panels
              border: '#27272a',   // Dark border
              text: {
                primary: '#f4f4f5',
                secondary: '#a1a1aa',
                muted: '#52525b'
              },
              accent: {
                DEFAULT: '#06b6d4', // Cyan technical accent
                glow: 'rgba(6, 182, 212, 0.2)',
                hover: '#0891b2'
              },
              status: {
                success: '#10b981',
                warning: '#f59e0b',
                danger: '#ef4444'
              }
            }
          },
          fontFamily: {
            sans: ['Geist', 'sans-serif'],
            mono: ['Geist Mono', 'monospace'],
          },
          boxShadow: {
            'glow': '0 0 15px rgba(6, 182, 212, 0.15)',
            'glow-accent': '0 0 20px rgba(6, 182, 212, 0.4)',
          }
        }
      }
    }
  </script>
<style data-purpose="custom-styles">
    body {
      background-color: theme('colors.app.bg');
      color: theme('colors.app.text.primary');
      font-family: 'Geist', sans-serif;
    }
    .panel {
      background-color: theme('colors.app.panel');
      border: 1px solid theme('colors.app.border');
      border-radius: 0.5rem;
    }
    .technical-border {
      border: 1px solid theme('colors.app.border');
      position: relative;
    }
    .technical-border::before {
      content: '';
      position: absolute;
      top: -1px;
      left: -1px;
      width: 4px;
      height: 4px;
      background-color: theme('colors.app.accent.DEFAULT');
    }
    
    /* Scrollbar styling */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: theme('colors.app.bg');
    }
    ::-webkit-scrollbar-thumb {
      background: theme('colors.app.border');
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: theme('colors.app.text.muted');
    }

    .stat-value {
      background: linear-gradient(to right, #fff, #a1a1aa);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  </style>
<!-- Lucide Icons -->
<script src="https://unpkg.com/lucide@latest"></script>
</head>
